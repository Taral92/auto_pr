# --- provider ---
# openai | anthropic. Both paths are live so the same eval fixtures can be
# scored against either; the translation lives in agent/model_client.py.
PROVIDER=openai

# --- OpenAI: the default path (Responses API) ---
OPENAI_API_KEY=
MODEL=gpt-5.6-luna
# Reasoning tokens are billed as output AND counted against MAX_OUTPUT_TOKENS.
# They can exhaust it before a single visible token is produced, which would
# starve the submit_findings call, so this is deliberately large.
MAX_OUTPUT_TOKENS=32000
# none | low | medium | high | xhigh | max
REASONING_EFFORT=low

# --- Anthropic: alternate provider, kept so Luna/Claude can be A/B scored ---
# Only read when PROVIDER=anthropic; MODEL above must then be a Claude id.
ANTHROPIC_API_KEY=
MAX_TOKENS=4096

# --- work budget: what a review actually costs ---
MAX_TOKENS_TOTAL=200000
MAX_WALL_CLOCK_S=300
MAX_TOOL_BYTES_TOTAL=120000
MAX_DIFF_BYTES=400000

# --- fuses: liveness only, not a work allowance ---
MAX_TURNS=25
MAX_UNPRODUCTIVE_TURNS=3

# --- database ---
DATABASE_URL=postgresql://autopr:autopr@localhost:5432/autopr
DB_POOL_SIZE=5

# --- GitHub App (production) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=          # base64 of the .pem, single line
GITHUB_WEBHOOK_SECRET=

# --- operator API (/api/*) ---
# Shared bearer secret for the operator endpoints. Unset disables them with a
# 503: /api/runs/{id}/trace returns private source, and /api/review spends model
# budget, so they fail closed rather than running open. The webhook is separate
# and stays public - it authenticates with GITHUB_WEBHOOK_SECRET per request.
OPERATOR_SECRET=

# --- CLI only (PAT). The only variable without a default. ---
GITHUB_TOKEN=

# --- worker ---
LEASE_S=900                      # must exceed MAX_WALL_CLOCK_S
MAX_ATTEMPTS=3
POLL_INTERVAL_S=2.0

# --- record/replay; the eval harness sets these itself ---
MODEL_MODE=live                  # live | record | replay
CASSETTE=
